# Core service configuration
APP_ENV=development                 # Application environment (development|staging|production)
APP_NAME="Sophia Voice Backend"     # Optional override for FastAPI title
API_RATE_LIMIT=30/minute            # Global API rate limit in SlowAPI syntax

# Authentication
API_KEYS=dev-key-1,dev-key-2        # Comma-separated list of valid API keys; required in production

# Supabase
SUPABASE_URL=https://your-project.supabase.co    # Supabase project REST URL (required)
SUPABASE_KEY=your-service-role-key               # Supabase service role key (required; keep secret)
SUPABASE_BUCKET_AUDIO=audio                      # Storage bucket for generated audio assets
SUPABASE_AUDIO_PREFIX=uploads/                   # Prefix/path inside the audio bucket
SUPABASE_DB_DSN=postgresql://user:pass@host/db   # Optional direct Postgres connection string
SUPABASE_DEFAULT_USER_ID=11111111-1111-1111-1111-111111111111  # Fallback UUID when no authenticated user is present (must not be zero UUID)

# Redis (conversation memory cache; optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# AI provider credentials
MISTRAL_API_KEY=                               # Required for Voxtral transcription/LLM in production
INWORLD_API_KEY=                               # Base64 Basic token for Inworld TTS (required for voice replies)
GOOGLE_API_KEY=                                # Enables Phoenix/Gemini emotion analysis; optional in dev
OPENAI_API_KEY=                                # Optional; used for Whisper fallback and TTS backup paths
ANTHROPIC_API_KEY=                             # Optional; used for Claude fallback in ResponseGenerator

# CORS and security controls
CORS_ALLOWED_ORIGINS=http://localhost:3000      # Comma-separated trusted origins for the frontend
API_PUBLIC_PATHS=/,/health,/docs,/openapi.json,/api  # Paths that bypass API-key enforcement
REQUIRE_CONSENT=true                            # Whether to enforce GDPR consent checks (set false in local dev only)

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=                    # OTLP collector endpoint (e.g., https://otlp.example.com/v1/traces)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-token  # Comma-separated key=value headers for OTLP exporter

# Misc
LOG_LEVEL=INFO                                  # Optional logging level override
