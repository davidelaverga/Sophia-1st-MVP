# Sophia Ai Companion Voice Agent - Environment Variables Template
# Copy this file to .env and fill with non-production values for local development only.
# For production and staging, set all variables in the Render dashboard Secrets panel.

# ========================================
# Application
# ========================================
APP_NAME=Sophia Voice Backend - Local
API_RATE_LIMIT=30/minute
API_KEYS=dev-key

# ========================================
# API Keys (local/dev only; production keys live only in Render)
# ========================================
MISTRAL_API_KEY=your_mistral_api_key_here
INWORLD_API_KEY=your_inworld_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# Voxtral Configuration (Audio processing)
# ========================================
# Enable/disable Voxtral unified pipeline
USE_VOXTRAL=true
# Fast model for UTILITY_DIRECT mode (speed priority, <1.5s latency target)
VOXTRAL_FAST_MODEL=voxtral-mini-latest
# Accurate model for LIGHT/EMOTIONAL/AGENTIC modes (quality priority)
VOXTRAL_ACCURATE_MODEL=voxtral-small-latest
# Timeout for Voxtral API calls in milliseconds
VOXTRAL_TIMEOUT_MS=30000

# ========================================
# Supabase Configuration
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_DSN=postgresql://postgres:password@host:5432/postgres
SUPABASE_BUCKET_AUDIO=audio-uploads
SUPABASE_AUDIO_PREFIX=uploads/
SUPABASE_DB_PASSWORD=your_db_password_here

# ========================================
# Redis (disabled by default to avoid connection errors in local dev)
# ========================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# ========================================
# OpenTelemetry (optional for local)
# ========================================
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# ========================================
# GDPR
# ========================================
REQUIRE_CONSENT=true
