# Sophia DeFi Voice Agent - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ========================================
# API Keys
# ========================================
MISTRAL_API_KEY=your_mistral_api_key_here
INWORLD_API_KEY=your_inworld_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# Supabase Configuration
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_KEY=your_supabase_service_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_DB_DSN=postgresql://postgres:password@host:port/database

# ========================================
# Redis Configuration (Docker handles this)
# ========================================
# REDIS_HOST=redis  # Automatically set by docker-compose
# REDIS_PORT=6379   # Automatically set by docker-compose

# ========================================
# API Security
# ========================================
API_KEYS=your_api_key_1,your_api_key_2

# ========================================
# Server Configuration
# ========================================
PORT=8000
PYTHONUNBUFFERED=1

# ========================================
# OpenTelemetry (Optional)
# ========================================
# OTEL_EXPORTER_OTLP_ENDPOINT=your_grafana_endpoint
# OTEL_EXPORTER_OTLP_HEADERS=your_auth_headers
