# Next.js Frontend Environment Variables
# Copy this to .env.local and fill in your actual values

# Supabase Configuration (REQUIRED)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Sophia Backend API
# Development (local backend)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000

# Production URLs (for deployment)
# For Vercel production deployment, use Render backend:
# NEXT_PUBLIC_API_URL=https://sophia-1st-mvp-xjml.onrender.com
# NEXT_PUBLIC_BACKEND_WS_URL=wss://sophia-1st-mvp-xjml.onrender.com

# Sentry Error Monitoring (Optional - for production observability)
# Sign up at https://sentry.io and create a project
# Get your DSN from: Settings → Projects → [Your Project] → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Set to "true" to enable Sentry in development mode (default: only enabled in production)
NEXT_PUBLIC_SENTRY_ENABLED=false

# Sentry Source Maps Upload (Optional - only needed for production builds)
# Required for proper error stack traces in Sentry dashboard
# Get auth token from: Settings → Account → API → Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

